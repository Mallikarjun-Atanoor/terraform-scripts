pipeline {
    agent any
    environment {
        DOCKER_IMAGE = 'mallikarjun7/python-app:v1'
        APP_NAME = 'mallikarjun7/python-webapp'
        TAG_VERSION = 'v2.2'
        }
    stages {
        stage('Pipeline execution begins from here') {
            steps {
                echo "Build started successfully"
                    }
        }      
        stage('Docker login') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'mallikarjun7', passwordVariable: 'DockerPassword', usernameVariable: 'DockerUsername')]) {
                    sh 'docker login -u ${DockerUsername} -p ${DockerPassword}'
                    echo "successfully logged into docker"
                }
            }
        }        
        stage('Docker image pull') {
            steps {
                sh 'docker pull ${DOCKER_IMAGE}'
                echo "successfully pulled image '${DOCKER_IMAGE}'"
                    }
        }
        stage('Docker image tagging') {
            steps {
                sh "docker tag ${DOCKER_IMAGE} ${APP_NAME}:${TAG_VERSION}"
                echo "successfully pulled image ${DOCKER_IMAGE}"
                echo "image tag success"
                            }
            }
        stage('Docker image push') {
            steps {
                sh "docker push ${APP_NAME}:${TAG_VERSION}"
                echo "successfully pushed ${DOCKER_IMAGE}"
                echo "image push success"
                            }
                    }    
            }
        post {
            success {
                echo "Build success"
            }
            failure {
                echo "Builf failed ${error}"
            }
            always {
                echo "Build executed successfully"
            }

        }    
    }        
